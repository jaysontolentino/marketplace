NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy projects can use NEXT_PUBLIC_SUPABASE_ANON_KEY instead.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
# Server-only Supabase key for seller accounts, reservations, and webhook order updates.
SUPABASE_SERVICE_ROLE_KEY=
# Alternatively use SUPABASE_SECRET_KEY for newer Supabase projects.
STRIPE_WEBHOOK_SECRET=
# Public production origin on Vercel. Use http://localhost:3000 for local development.
APP_URL=http://localhost:3000
